# ==============================================================================
# Repair Before Replace - Environment Configuration
# Copy this file to .env and fill in the values appropriate for your environment.
# All API keys are completely optional: the system runs fully offline via
# deterministic expert rules and built-in template fallbacks.
# ==============================================================================

# Google Gemini API key (optional, for Gemini-assisted fault selection and explanations)
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Roboflow Hosted Inference API (optional, for hosted computer vision component detection)
# https://roboflow.com/
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=laptop-components/1

# Gemma / Ollama Local Backend (optional, for offline local LLM explanations)
# Run `ollama pull gemma3:4b` to use local Gemma
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

